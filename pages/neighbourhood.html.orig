<dialog class="concierge" id="ask-dialog" aria-labelledby="ask-dialog-title">
  <div class="concierge-head">
    <img src="../assets/images/logo/zungu-logo-160.webp" width="56" height="57" alt="" decoding="async" loading="lazy">
    <div>
      <p class="eyebrow">Ask Zungu Hotel</p>
      <h2 id="ask-dialog-title">Karibu 👋</h2>
      <p id="ask-lead">How can we help? Choose a topic and we'll open WhatsApp with your message ready.</p>
    </div>
    <button class="concierge-close" type="button" data-close-ask aria-label="Close">×</button>
  </div>
  <div class="concierge-body">
    <div id="ask-topics"><ul class="quick-list" data-quick-actions></ul></div>
    <form id="ask-form" hidden novalidate>
      <input type="text" name="website" value="" autocomplete="off" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px;opacity:0;height:0;width:0">
      <input type="hidden" name="form_loaded" value="">
      <label class="field"><span>Your name</span><input name="name" type="text" autocomplete="name" placeholder="Full name"></label>
      <div class="field-row">
        <label class="field"><span>Check-in</span><input name="checkin" type="date"></label>
        <label class="field"><span>Check-out</span><input name="checkout" type="date"></label>
      </div>
      <p class="nights" id="ask-nights" aria-live="polite"></p>
      <div class="field-row">
        <div class="field"><span id="g-l">Guests</span>
          <div class="stepper" role="group" aria-labelledby="g-l">
            <button type="button" data-for="guests" data-step="-1" aria-label="Fewer guests">−</button>
            <input name="guests" type="number" min="1" max="12" value="2" inputmode="numeric" aria-labelledby="g-l">
            <button type="button" data-for="guests" data-step="1" aria-label="More guests">+</button>
          </div></div>
        <div class="field"><span id="r-l">Rooms</span>
          <div class="stepper" role="group" aria-labelledby="r-l">
            <button type="button" data-for="rooms" data-step="-1" aria-label="Fewer rooms">−</button>
            <input name="rooms" type="number" min="1" max="6" value="1" inputmode="numeric" aria-labelledby="r-l">
            <button type="button" data-for="rooms" data-step="1" aria-label="More rooms">+</button>
          </div></div>
      </div>
      <label class="field"><span>Anything else? (optional)</span><textarea name="notes" rows="2" placeholder="Arrival time, special requests…"></textarea></label>
      <p class="form-error" id="ask-error" role="alert"></p>
      <div class="form-actions">
        <button class="btn btn--ghost-light" type="button" data-back>Back</button>
        <button class="btn btn--gold" type="submit">Continue to WhatsApp</button>
      </div>
      <p class="form-note">The hotel replies on WhatsApp to confirm availability and rates. Nothing is booked until they confirm. Your details prepare a WhatsApp draft; you choose whether to send it. <a href="privacy.html">Privacy Policy</a>.</p>
    </form>
  </div>
  <div class="concierge-foot">
    <a href="tel:+255766003050" data-track="phone_click">Call +255 766 003 050</a>
    <a href="https://maps.app.goo.gl/AhsCizjzyFCqkFHN9" target="_blank" rel="noopener" data-track="maps_click">Open in Google Maps</a>
  </div>
</dialog>
